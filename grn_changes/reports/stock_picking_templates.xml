<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="inherit_stock_delivery_report_signature"
              inherit_id="stock.report_delivery_document">

        <xpath expr="//div[@name='div_vehicle_no']" position="after">

            <div class="row mt16 mb16" style="width:100%;">
                <div class="col-4">
                    <strong>Requested Department:</strong><br/>
                    <span t-field="o.requested_department_id"/>
                </div>
                <div class="col-4">
                    <strong>Requested Division:</strong><br/>
                    <span t-field="o.requested_division_id"/>
                </div>
                <div class="col-4">
                    <strong>Requested Sub Division:</strong><br/>
                    <span t-field="o.requested_sub_division_id"/>
                </div>
            </div>

            <div class="row mt16 mb16" style="width:100%;">
                <div class="col-4">
                    <strong>Sub Division Manager:</strong><br/>
                    <span t-field="o.sub_division_manager_id"/>
                </div>
                <div class="col-4">
                    <strong>Indent Request Person:</strong><br/>
                    <span t-field="o.indent_person_id"/>
                </div>
                <div class="col-4">
                    <strong>Indent Person Ph Number:</strong><br/>
                    <span t-field="o.indent_person_phone"/>
                </div>
            </div>

        </xpath>

        <xpath expr="//div[@class='page']" position="inside">

            <div style="width:100%; margin-top:40px; text-align:right;">

                <div t-if="o.digital_signature">
                    <img t-att-src="'data:image/png;base64,%s' % o.digital_signature.decode('utf-8')"
                         style="max-height:80px; max-width:200px;"/>
                </div>
                <div>
                    <strong>Prepared By:</strong>
                    <span t-field="o.prepared_by"/>
                </div>
                <div>
                    <strong>Approved By:</strong>
                    <span t-field="o.approved_by"/>
                </div>
                <div>
                    <strong>Authorised By:</strong>
                    <span t-field="o.authorised_by"/>
                </div>
            </div>

        </xpath>

    </template>

    <template id="inherit_stock_report_picking_signature"
