<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_signature_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.signature.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Signatures" name="signatures">
                    <group>
                        <group string="Approval">
                            <field name="prepared_by"/>
                            <field name="approved_by"/>
                            <field name="authorised_by"/>
                        </group>
                        <group string="Digital Signature">
                            <field name="digital_signature" widget="image"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
