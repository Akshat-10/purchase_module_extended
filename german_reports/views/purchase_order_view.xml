<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add order_type field to Purchase Order form view -->
    <record id="purchase_order_form_view_inherit_order_type" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.order.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add order_type field above partner_ref -->
            <xpath expr="//field[@name='partner_ref']" position="before">
                <field name="order_type" string="Order Type"/>
            </xpath>
        </field>
    </record>

    <!-- Add purchase_order_date field - visible only when state is purchase/done -->
    <record id="purchase_order_form_view_inherit_purchase_order_date" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase.order.date</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add purchase_order_date field after date_approve -->
            <xpath expr="//div[@name='date_approve']" position="after">
                <label for="purchase_order_date" invisible="state not in ['purchase', 'done']"/>
                <div name="purchase_order_date_div" class="o_row" invisible="state not in ['purchase', 'done']">
                    <field name="purchase_order_date"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Show po_confirmed_number only for purchase_order type in confirmed states -->
    <record id="purchase_order_form_view_inherit_confirmed_po_number" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.confirmed.po.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="german_default_data.view_purchase_order_form_confirmed_po_number"/>
        <field name="arch" type="xml">
            <!-- Update visibility condition for po_confirmed_number -->
            <xpath expr="//field[@name='po_confirmed_number']" position="attributes">
                <attribute name="invisible">not po_confirmed_number or order_type != 'purchase_order' or state not in ['purchase', 'done']</attribute>
            </xpath>
        </field>
    </record>

    <!-- Update tree view visibility for po_confirmed_number -->
    <record id="purchase_order_tree_view_inherit_confirmed_po_number" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.confirmed.po.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="german_default_data.view_purchase_order_tree_confirmed_po_number"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='po_confirmed_number']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Add order_type aware tree column for po_confirmed_number and purchase_order_date -->
    <record id="purchase_order_tree_view_confirmed_po_with_order_type" model="ir.ui.view">
        <field name="name">purchase.order.tree.confirmed.po.order.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="order_type" optional="hide"/>
                <field name="po_confirmed_number" 
                       optional="show"
                       decoration-muted="not po_confirmed_number"/>
                <field name="purchase_order_date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
