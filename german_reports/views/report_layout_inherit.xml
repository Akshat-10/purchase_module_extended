<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inherit external layout to replace header and footer with images -->
  <template id="external_layout_standard_inherit_gr_header" inherit_id="web.external_layout_standard">
    <xpath expr="//div[contains(@t-attf-class, 'header')][contains(@t-attf-class, 'o_company_')]" position="replace">
  <div t-attf-class="header o_company_#{company.id}_layout o_gr_fullbleed_header mx-0 px-0">
        <t t-if="company.report_header_image">
          <img t-att-src="image_data_uri(company.report_header_image)" style="width:100%;" alt="Header"/>
        </t>
      </div>
    </xpath>
  </template>

  <template id="external_layout_bold_inherit_gr_header" inherit_id="web.external_layout_bold">
    <xpath expr="//div[contains(@t-attf-class, 'header')][contains(@t-attf-class, 'o_company_')]" position="replace">
  <div t-attf-class="header o_company_#{company.id}_layout o_gr_fullbleed_header mx-0 px-0" t-att-style="report_header_style">
        <t t-if="company.report_header_image">
          <img t-att-src="image_data_uri(company.report_header_image)" style="width:100%;" alt="Header"/>
        </t>
      </div>
    </xpath>
  </template>

